# Web deployment: PostgreSQL and Qunl are mandatory. Do not commit real secrets.
# Use a URL-safe password here, and the same password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://huobao:REPLACE_PASSWORD@postgres:5432/huobao
# Existing trusted network shared with Qunl (production Compose only).
QUNL_DOCKER_NETWORK=

# 构建镜像时注入的版本号（发布时指定，如 1.2.0；本地构建保持 dev 即可）
HUOBAO_VERSION=dev

# Model URLs and API keys are saved per user in the settings page.
# The retired automatic-token source "qunl" is not accepted.
HUOBAO_MODEL_CONFIG_SOURCE=user

# 与 Qunl 侧保持一致的服务间密钥，至少 32 个字符
HUOBAO_PROXY_SECRET=

# Qunl owns the public origin and /huobao/ prefix, including local HTTP testing.
HUOBAO_CORS_ORIGINS=http://localhost:3000
HUOBAO_PUBLIC_BASE_URL=http://localhost:3000/huobao
HUOBAO_LOCAL_PORT=5679

# Optional overrides for backend resource limits; see backend/src/config/env.ts.
HUOBAO_PROMPT_MAX_LENGTH=20000
HUOBAO_SKILL_MAX_LENGTH=20000
HUOBAO_SKILLS_MAX_PER_AGENT=10
HUOBAO_AGENT_TEXT_MAX_LENGTH=60000
# PostgreSQL integration tests need their own database-creation-capable test user.
HUOBAO_TEST_DATABASE_URL=postgres://huobao_test:REPLACE_TEST_PASSWORD@127.0.0.1:55432/postgres
HUOBAO_TEST_POSTGRES_PASSWORD=
HUOBAO_TEST_POSTGRES_PORT=55432
